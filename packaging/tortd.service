[Unit]
Description=tort privileged daemon (Tor tunnel)
Documentation=https://github.com/nzkritik/tort
# The daemon manages its own tor instance; it must not race the system one.
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/tort daemon
Restart=on-failure
RuntimeDirectory=tort
RuntimeDirectoryMode=0755
StateDirectory=tort
StateDirectoryMode=0700

# Sandboxing is deliberately minimal, and that is a considered decision rather
# than an oversight.
#
# This daemon execs arbitrary user programs - that is what `tort run` is - so
# every sandboxing directive it carries is inherited by the user's browser
# rather than confining the daemon. The restriction lands on the wrong process
# and surfaces as a baffling error a long way from its cause:
#
#   ProtectHome=yes      hides /run/user, so a graphical application fails with
#                        "Failed to connect to Wayland display: Permission
#                        denied" - nothing about that message suggests a unit
#                        file.
#   PrivateTmp=yes       gives each run its own /tmp, silently breaking browser
#                        profiles under /tmp/... and defeating --user-data-dir.
#   LockPersonality=yes  blocks personality(), which Chromium's sandbox uses.
#
# None of them confine the daemon in any meaningful way either: it is root, and
# it creates network namespaces, rewrites nftables and changes uid. A sandbox
# that permits all of that is not restricting much.
#
# What remains costs the child nothing and is kept.
NoNewPrivileges=no
ProtectHostname=yes
ProtectKernelLogs=yes
RestrictSUIDSGID=no

[Install]
WantedBy=multi-user.target
