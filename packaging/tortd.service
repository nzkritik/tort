[Unit]
Description=tort privileged daemon (Tor tunnel)
Documentation=https://github.com/nzkritik/tort
# The daemon manages its own tor instance; it must not race the system one.
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/tort daemon
Restart=on-failure
RuntimeDirectory=tort
RuntimeDirectoryMode=0755
StateDirectory=tort
StateDirectoryMode=0700

# The daemon needs real privilege - it creates network namespaces, edits
# nftables and changes uid - so most sandboxing would break it. What can be
# given up safely is given up.
NoNewPrivileges=no
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=no
LockPersonality=yes

[Install]
WantedBy=multi-user.target
